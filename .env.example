# PostgreSQL
DATABASE_URL="postgresql://rurbit:rurbit_dev_password@localhost:5432/rurbit_pay?schema=public"

# Generate one with: openssl rand -base64 32
# Exactly 32 random bytes encoded as base64 (preferred) or 64 hex characters.
ENCRYPTION_SECRET="REPLACE_WITH_32_RANDOM_BYTES_BASE64"

NODE_ENV="development"
PORT="4000"
FRONTEND_ORIGIN="http://localhost:5173"
